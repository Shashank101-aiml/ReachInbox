# --- Server ---
PORT=
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- BullMQ worker tuning ---
# Number of jobs the worker processes concurrently.
WORKER_CONCURRENCY=5
# Minimum delay (ms) enforced between individual email sends (per worker slot).
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Global cap on emails sent per rolling hour window. Set 0 to disable global limit.
MAX_EMAILS_PER_HOUR=200
# Per-sender cap on emails sent per rolling hour window. Set 0 to disable per-sender limit.
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# --- Auth (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:/api/auth/google/callback
JWT_SECRET=change-me-in-production
SESSION_COOKIE_NAME=reachinbox_session

# --- Ethereal SMTP senders ---
# Comma-separated list of sender ids configured in src/config/senders.ts
# Each sender's actual host/user/pass is provided via SENDER_<ID>_* vars below.
SMTP_SENDER_IDS=sender1,sender2
SENDER_SENDER1_HOST=smtp.ethereal.email
SENDER_SENDER1_PORT=587
SENDER_SENDER1_USER=
SENDER_SENDER1_PASS=
SENDER_SENDER1_FROM_NAME=ReachInbox Sender 1

SENDER_SENDER2_HOST=smtp.ethereal.email
SENDER_SENDER2_PORT=587
SENDER_SENDER2_USER=
SENDER_SENDER2_PASS=
SENDER_SENDER2_FROM_NAME=ReachInbox Sender 2
